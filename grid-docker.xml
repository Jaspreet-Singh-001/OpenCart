<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Docker Selenium Grid Suite" parallel="tests" thread-count="2">
    <listeners>
        <listener class-name="utilities.ExtentReportManager"/>
    </listeners>

    <test name="Docker Linux Chrome" preserve-order="true">
        <parameter name="os" value="Linux"/>
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="testCases.TC001_OpenCartRegistrationTest"/>
            <class name="testCases.TC004_SimpleLoginTest"/>
        </classes>
    </test>

    <test name="Docker Linux Firefox" preserve-order="true">
        <parameter name="os" value="Linux"/>
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="testCases.TC001_OpenCartRegistrationTest"/>
            <class name="testCases.TC004_SimpleLoginTest"/>
        </classes>
    </test>
    
    <test name="Grouping Test Execution">
        <parameter name="os" value="Linux"/>
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="testCases.TC001_OpenCartRegistrationTest"/>
            <class name="testCases.TC002_OpenCartRegistrationDDT"/>
            <class name="testCases.TC003_LoginDDT"/>
            <class name="testCases.TC004_SimpleLoginTest"/>
            <class name="testCases.TC005_RegistrationLoginDependencyTest"/>

        </classes>
    </test>
</suite>